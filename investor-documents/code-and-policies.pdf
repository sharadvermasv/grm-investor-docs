/*TYPOGRAPHY*/body{font-family:"Open Sans";font-weight:400;color:#206341;}h1,h2,h3,h4,h5,h6{font-family:"Montserrat";font-weight:500;}#main-nav > ul > li > a{font-family:"Open Sans";font-weight:600;font-size:14px;}#main-nav .sub-menu li a{font-family:"Open Sans";font-weight:600;font-size:14px;}#main-nav-mobi ul > li > a{font-family:"Open Sans";font-size:14px;}#featured-title .main-title{font-family:"Montserrat";}#featured-title .sub-title{font-family:"Montserrat";}#featured-title #breadcrumbs{font-family:"Montserrat";}.hentry .post-title{font-family:"Montserrat";}.is-single-post .hentry .post-title{font-family:"Montserrat";}button, input[type="button"], input[type="reset"], input[type="submit"]{font-family:"Open Sans";font-weight:500;text-transform:uppercase;}.agrikole-pagination, .woocommerce-pagination{font-family:"Montserrat";}#sidebar .widget .widget-title{font-family:"Montserrat";}#footer-widgets .widget .widget-title{font-family:"Montserrat";font-size:24px !important;line-height:30px !important;}#bottom .bottom-bar-copyright a{font-family:"Open Sans";font-weight:500;}h1{font-family:"Montserrat";font-weight:500;}h2{font-family:"Montserrat";font-weight:500;font-size:35px !important;line-height:45px !important;}h3{font-family:"Montserrat";font-weight:500;font-size:25px ;}h4{font-family:"Open Sans";font-weight:500;font-size:40px;color:#206341;line-height:47;}#copyright{font-family:"Open Sans";font-weight:400;}/*ACCENT COLOR*/.text-accent-color,.link-dark:hover,.link-gray:hover,.sticky-post,#site-logo .site-logo-text:hover,.header-style-3 #site-header .nav-top-cart-wrapper .nav-cart-trigger:hover,.header-style-3 #site-header .header-search-trigger:hover,.header-style-3 .header-info > .content:before,.header-style-5 #site-header .nav-top-cart-wrapper .nav-cart-trigger:hover,.header-style-5 #site-header .header-search-trigger:hover,.hentry .post-tags .inner:before,#featured-title #breadcrumbs a:hover,.hentry .page-links span,.hentry .page-links a span,.hentry .post-t